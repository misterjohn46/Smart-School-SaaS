parameters:
	ignoreErrors:
		-
			message: '#^Instanceof between Laravel\\Sanctum\\PersonalAccessToken and Laravel\\Sanctum\\PersonalAccessToken will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Http/Controllers/Api/V1/AuthController.php

		-
			message: '#^Parameter \#1 \$user of class Illuminate\\Auth\\Events\\Verified constructor expects Illuminate\\Contracts\\Auth\\MustVerifyEmail, App\\Models\\User given\.$#'
			identifier: argument.type
			count: 1
			path: app/Http/Controllers/Auth/VerifyEmailController.php

		-
			message: '#^Anonymous function should return array\{id\: int, order_number\: string, buyer_name\: string, buyer_nisn\: string, total_amount\: float, payment_method\: ''cash''\|''wallet'', order_status\: ''cancelled''\|''completed''\|''cooking''\|''pending''\|''ready'', order_date\: non\-falsy\-string, \.\.\.\} but returns array\{id\: int, order_number\: string, buyer_name\: string, buyer_nisn\: string, total_amount\: float, payment_method\: ''cash''\|''wallet'', order_status\: ''cancelled''\|''completed''\|''cooking''\|''pending''\|''ready'', order_date\: non\-falsy\-string, \.\.\.\}\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/CanteenController.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 1
			path: app/Http/Controllers/ClassroomAttendanceController.php

		-
			message: '#^Left side of && is always true\.$#'
			identifier: booleanAnd.leftAlwaysTrue
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Match arm comparison between ''tugas_luar'' and ''tugas_luar'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Right side of && is always true\.$#'
			identifier: booleanAnd.rightAlwaysTrue
			count: 1
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Ternary operator condition is always true\.$#'
			identifier: ternary.alwaysTrue
			count: 2
			path: app/Http/Controllers/DashboardController.php

		-
			message: '#^Anonymous function should return array\{id\: int, hash_id\: string, name\: string, nisn\: string, classroom\: string, rfid_uid\: string\|null, wallet_balance\: float, bills\: Illuminate\\Support\\Collection\<int, array\{id\: mixed, title\: mixed, category\: mixed, amount\: float, paid_amount\: float, remaining_amount\: float, month\: mixed, year\: mixed, \.\.\.\}\>, \.\.\.\} but returns array\{id\: int, hash_id\: string, name\: string, nisn\: string, classroom\: string, rfid_uid\: string\|null, wallet_balance\: float, bills\: Illuminate\\Support\\Collection\<int, array\{id\: int, title\: mixed, category\: mixed, amount\: float, paid_amount\: float, remaining_amount\: float, month\: mixed, year\: mixed, \.\.\.\}\>, \.\.\.\}\.$#'
			identifier: return.type
			count: 1
			path: app/Http/Controllers/FinanceController.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 1
			path: app/Http/Controllers/FinanceController.php

		-
			message: '#^Expression on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.expr
			count: 2
			path: app/Http/Controllers/KtsController.php

		-
			message: '#^Access to an undefined property App\\Models\\StudentProfile\:\:\$total_points\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/StudentViolationController.php

		-
			message: '#^Access to an undefined property App\\Models\\StudentProfile\:\:\$total_violations\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Controllers/StudentViolationController.php

		-
			message: '#^Call to function method_exists\(\) with App\\Models\\User and ''hasRole'' will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: app/Http/Middleware/FilamentAuthenticateWithRoleRedirect.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$created_at\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$email\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$email_verified_at\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$id\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$name\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Access to an undefined property App\\Http\\Resources\\UserResource\:\:\$roles\.$#'
			identifier: property.notFound
			count: 1
			path: app/Http/Resources/UserResource.php

		-
			message: '#^Match arm comparison between ''sabtu'' and ''sabtu'' is always true\.$#'
			identifier: match.alwaysTrue
			count: 1
			path: app/Models/LessonSchedule.php
