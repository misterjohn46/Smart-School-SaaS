includes:
    - vendor/larastan/larastan/extension.neon
    # Baseline berisi 23 error sisa yang seluruhnya keterbatasan inferensi
    # larastan, bukan bug: properti magic JsonResource, alias withCount/withSum,
    # dan guard defensif yang dianggap selalu benar. Turun dari 315 setelah 103
    # relasi model diberi anotasi generic.
    # Jangan regenerate baseline untuk menutup error baru - perbaiki errornya.
    - phpstan-baseline.neon
parameters:
    paths:
        - app
    level: 5
    ignoreErrors:
        # larastan menganggap relasi BelongsTo dengan foreign key NOT NULL selalu
        # mengembalikan model (non-nullable), sehingga `$model->relasi?->kolom`
        # dilaporkan sebagai nullsafe yang tidak perlu. Asumsi itu tidak aman:
        # baris terkait bisa hilang (data lama, hapus manual, FK nullOnDelete),
        # dan `?->` di sini memang disengaja sebagai pengaman tampilan.
        - identifier: nullsafe.neverNull
    tmpDir: storage/framework/cache/phpstan
    # Analisis proyek ini melampaui memory_limit PHP bawaan (128M) dan prosesnya
    # crash, bukan sekadar melaporkan error. CI menjalankannya dengan --memory-limit=2G.
    parallel:
        maximumNumberOfProcesses: 4
